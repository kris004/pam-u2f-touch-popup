#!/bin/bash -p
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

readonly program='pam-u2f-touch-popup'
readonly default_service='pam-u2f-touch-popup.service'
readonly device_path_unit='pam-u2f-touch-popup-device.path'
readonly device_service='pam-u2f-touch-popup-device.service'
# Test dependency injection belongs only in generated, non-elevating fixtures.
if [[ ${PAM_U2F_TOUCH_POPUP_SETUP_TESTING:-0} != 0 ]]; then
  printf '%s\n' 'error: runtime setup testing is not supported' >&2
  exit 2
fi
readonly sys_class_hidraw='/sys/class/hidraw'
readonly sys_devices='/sys/devices'
readonly rule_path='/etc/udev/rules.d/70-pam-u2f-touch-popup-device-gate.rules'
readonly marker_path='/dev/pam-u2f-touch-popup-key'

declare -a device_ids=()
declare -a device_labels=()
selected_device_id=

usage() {
  local help_text
  IFS= read -r -d '' help_text <<'EOF' || :
Usage:
  pam-u2f-touch-popup-setup list
  pam-u2f-touch-popup-setup enable [--yes] [VENDOR_ID:PRODUCT_ID]
  pam-u2f-touch-popup-setup status
  pam-u2f-touch-popup-setup disable [--yes]

Commands:
  list      List connected FIDO authenticator models.
  enable    Select a model, install its udev rule, and enable device gating.
  status    Show the gate rule, marker, and user-unit states.
  disable   Remove device gating and restore the default service.

Run this command as the desktop user, not with sudo. The enable and disable
commands invoke sudo only for the system udev rule.
EOF
  printf '%s\n' "${help_text}"
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'warning: %s\n' "$*" >&2
}

find_command() {
  local name=$1
  local path

  for path in \
    "/usr/bin/${name}" \
    "/usr/sbin/${name}" \
    "/bin/${name}" \
    "/sbin/${name}"; do
    if [[ -f ${path} && -x ${path} ]]; then
      printf '%s\n' "${path}"
      return
    fi
  done
  die "required command not found in a system directory: ${name}"
}

systemctl_user() {
  local systemctl_cmd=$1
  local SYSTEMD_PAGER=cat
  shift
  export SYSTEMD_PAGER
  "${systemctl_cmd}" --user --no-pager "$@"
}

sanitize_label() {
  local label=$1

  label=${label//_/ }
  label=${label//[[:cntrl:]]/ }
  printf '%s\n' "${label}"
}

discover_devices() {
  local udevadm_cmd=$1
  local sysdev parent usb_parent kernel_properties properties property value
  local fido vendor_id product_id vendor_name model_name id label
  local existing known

  device_ids=()
  device_labels=()
  shopt -s nullglob
  for sysdev in "${sys_class_hidraw}"/hidraw*; do
    if ! properties=$("${udevadm_cmd}" info --query=property --path="${sysdev}" 2>/dev/null); then
      continue
    fi

    fido=
    vendor_id=
    product_id=
    vendor_name=
    model_name=
    while IFS='=' read -r property value; do
      case ${property} in
        ID_FIDO_TOKEN) fido=${value} ;;
        ID_VENDOR_ID) vendor_id=${value} ;;
        ID_MODEL_ID) product_id=${value} ;;
        ID_VENDOR) vendor_name=${value} ;;
        ID_MODEL) model_name=${value} ;;
      esac
    done <<<"${properties}"

    [[ ${fido} == 1 ]] || continue
    # Some udev distributions identify FIDO hidraw nodes without importing
    # USB identity properties. Read both IDs from the same kernel USB parent.
    if [[ ! ${vendor_id} =~ ^[0-9A-Fa-f]{4}$ ||
          ! ${product_id} =~ ^[0-9A-Fa-f]{4}$ ]]; then
      parent=$(cd -P -- "${sysdev}/device" 2>/dev/null && pwd -P) || continue
      vendor_id=
      product_id=
      while [[ ${parent} == "${sys_devices}"/* ]]; do
        [[ -d ${parent} && -r ${parent}/uevent ]] || break
        if ! kernel_properties=$(<"${parent}/uevent") || [[ -z ${kernel_properties} ]]; then
          break
        fi
        usb_parent=false
        while IFS='=' read -r property value; do
          if [[ ${property} == DEVTYPE && ${value} == usb_device ]]; then
            usb_parent=true
          fi
        done <<<"${kernel_properties}"
        if [[ ${usb_parent} == true ]]; then
          # Missing key attributes must not select an upstream USB hub.
          [[ -r ${parent}/idVendor && -r ${parent}/idProduct ]] || break
          if ! { IFS= read -r vendor_id <"${parent}/idVendor" &&
                 IFS= read -r product_id <"${parent}/idProduct"; }; then
            vendor_id=
            product_id=
            break
          fi
          if [[ -z ${vendor_name} && -r ${parent}/manufacturer ]]; then
            IFS= read -r vendor_name <"${parent}/manufacturer" || vendor_name=
          fi
          if [[ -z ${model_name} && -r ${parent}/product ]]; then
            IFS= read -r model_name <"${parent}/product" || model_name=
          fi
          break
        fi
        parent=${parent%/*}
      done
    fi
    [[ ${vendor_id} =~ ^[0-9A-Fa-f]{4}$ ]] || continue
    [[ ${product_id} =~ ^[0-9A-Fa-f]{4}$ ]] || continue
    id="${vendor_id,,}:${product_id,,}"

    known=false
    for existing in "${device_ids[@]}"; do
      if [[ ${existing} == "${id}" ]]; then
        known=true
        break
      fi
    done
    [[ ${known} == false ]] || continue

    vendor_name=$(sanitize_label "${vendor_name:-Unknown vendor}")
    model_name=$(sanitize_label "${model_name:-Unknown model}")
    label="${vendor_name} ${model_name}"
    device_ids+=("${id}")
    device_labels+=("${label}")
  done
  shopt -u nullglob
}

print_devices() {
  local index

  if (( ${#device_ids[@]} == 0 )); then
    printf '%s\n' 'No connected FIDO authenticators were found.'
    return
  fi

  printf '%s\n' 'Connected FIDO authenticator models:'
  for ((index = 0; index < ${#device_ids[@]}; index++)); do
    printf '  %d. %s (%s)\n' \
      "$((index + 1))" "${device_labels[index]}" "${device_ids[index]}"
  done
}

normalize_device_id() {
  local id=$1

  [[ ${id} =~ ^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}$ ]] || \
    die "device ID must have the form VENDOR_ID:PRODUCT_ID, for example 1050:0402"
  printf '%s\n' "${id,,}"
}

choose_device() {
  local udevadm_cmd=$1
  local choice index

  discover_devices "${udevadm_cmd}"
  print_devices >&2
  (( ${#device_ids[@]} > 0 )) || \
    die 'connect the desired key or pass its VENDOR_ID:PRODUCT_ID explicitly'

  if (( ${#device_ids[@]} == 1 )); then
    selected_device_id=${device_ids[0]}
    printf 'Using the only detected model: %s (%s)\n' \
      "${device_labels[0]}" "${selected_device_id}" >&2
    return
  fi

  [[ -t 0 ]] || \
    die 'multiple models were found; pass VENDOR_ID:PRODUCT_ID explicitly'
  read -r -p "Select a model [1-${#device_ids[@]}]: " choice
  [[ ${choice} =~ ^[0-9]+$ ]] || die 'selection must be a number'
  index=$((10#${choice} - 1))
  (( index >= 0 && index < ${#device_ids[@]} )) || die 'selection is out of range'
  selected_device_id=${device_ids[index]}
}

confirm_or_exit() {
  local assume_yes=$1
  local prompt=$2
  local response

  if [[ ${assume_yes} == true ]]; then
    return
  fi
  [[ -t 0 ]] || die 'confirmation requires a terminal; rerun with --yes if appropriate'
  read -r -p "${prompt} [y/N] " response
  case ${response} in
    y|Y|yes|YES|Yes) ;;
    *)
      printf '%s\n' 'Cancelled.'
      exit 0
      ;;
  esac
}

rule_is_related() {
  local line

  [[ -r ${rule_path} ]] || return 1
  while IFS= read -r line; do
    [[ ${line} == *'SYMLINK+="pam-u2f-touch-popup-key"'* ]] && return 0
  done <"${rule_path}"
  return 1
}

privileged_setup() {
  local sudo_cmd=$1
  local code
  shift

  # Pass constant code as an argument, never a user-owned script/rule pathname
  # or stdin. Only the operation and normalized USB ID cross this boundary.
  IFS= read -r -d '' code <<'PRIVILEGED_SETUP' || :
set -euo pipefail
# System directories stay traversable; private staging below uses umask 077.
umask 022
readonly rule_dir='/etc/udev/rules.d'
readonly rule_path='/etc/udev/rules.d/70-pam-u2f-touch-popup-device-gate.rules'
temp_dir=

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
find_command() {
  local name=$1 path
  for path in "/usr/bin/${name}" "/usr/sbin/${name}" "/bin/${name}" "/sbin/${name}"; do
    if [[ -f ${path} && -x ${path} ]]; then
      printf '%s\n' "${path}"
      return
    fi
  done
  die "required command not found in a system directory: ${name}"
}
rule_is_related() {
  local line
  [[ ! -L ${rule_path} && -f ${rule_path} && -r ${rule_path} ]] || return 1
  while IFS= read -r line; do
    [[ ${line} == *'SYMLINK+="pam-u2f-touch-popup-key"'* ]] && return 0
  done <"${rule_path}"
  return 1
}
cleanup() {
  if [[ -n ${temp_dir} ]]; then
    "${rm_cmd}" -rf -- "${temp_dir}"
  fi
}

(( EUID == 0 )) || die 'the privileged setup operation requires root'
case ${1-} in
  enable)
    (( $# == 2 )) || die 'enable requires one normalized USB ID'
    [[ $2 =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ ]] || die 'invalid normalized USB ID'
    ;;
  disable) (( $# == 1 )) || die 'disable does not accept arguments' ;;
  *) die 'unknown privileged setup operation' ;;
esac

if [[ -e ${rule_path} || -L ${rule_path} ]] && ! rule_is_related; then
  die "${rule_path} exists but is not a pam-u2f-touch-popup device-gate rule"
fi
rm_cmd=$(find_command rm)
udevadm_cmd=$(find_command udevadm)

if [[ $1 == enable ]]; then
  device_id=$2
  vendor_id=${device_id%:*}
  product_id=${device_id#*:}
  mkdir_cmd=$(find_command mkdir)
  mktemp_cmd=$(find_command mktemp)
  chmod_cmd=$(find_command chmod)
  mv_cmd=$(find_command mv)
  sync_cmd=$(find_command sync)
  "${mkdir_cmd}" -p -- "${rule_dir}"
  umask 077
  # Private root-owned staging on the destination filesystem binds validation
  # to the bytes atomically renamed into place, without a same-UID source race.
  temp_dir=$("${mktemp_cmd}" -d "${rule_dir}/.pam-u2f-touch-popup.XXXXXXXX")
  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  generated_rule="${temp_dir}/70-pam-u2f-touch-popup-device-gate.rules"
  printf '%s\n' \
    '# SPDX-License-Identifier: GPL-3.0-or-later' \
    '# Managed by pam-u2f-touch-popup-setup. Manual edits may be replaced.' \
    "# Match every FIDO authenticator with USB ID ${device_id}." \
    '' \
    "SUBSYSTEM==\"hidraw\", KERNEL==\"hidraw*\", ENV{ID_FIDO_TOKEN}==\"1\", \\" \
    "  ATTRS{idVendor}==\"${vendor_id}\", ATTRS{idProduct}==\"${product_id}\", TAG+=\"systemd\", \\" \
    "  SYMLINK+=\"pam-u2f-touch-popup-key\", \\" \
    '  ENV{SYSTEMD_ALIAS}+="/dev/pam-u2f-touch-popup-key"' >"${generated_rule}"
  "${chmod_cmd}" 0644 -- "${generated_rule}"
  if "${udevadm_cmd}" verify --help >/dev/null 2>&1; then
    if ! output=$("${udevadm_cmd}" verify "${generated_rule}" 2>&1); then
      printf '%s\n' "${output}" >&2
      die 'generated udev rule failed validation'
    fi
  fi
  "${sync_cmd}" -f "${generated_rule}"
  "${mv_cmd}" -fT -- "${generated_rule}" "${rule_path}"
  "${sync_cmd}" -f "${rule_dir}"
else
  "${rm_cmd}" -f -- "${rule_path}"
fi

"${udevadm_cmd}" control --reload || die 'the rule was changed, but udev could not reload it'
if ! "${udevadm_cmd}" trigger --action=change --subsystem-match=hidraw; then
  warn 'udev was reloaded, but existing hidraw devices could not be retriggered; reconnect the selected key'
elif ! "${udevadm_cmd}" settle; then
  warn 'udev did not settle cleanly; reconnect the selected key if the gate marker is absent'
fi
PRIVILEGED_SETUP
  "${sudo_cmd}" -- /bin/bash -p -c "${code}" "${program}-setup" "$@"
}

unit_state() {
  local systemctl_cmd=$1
  local action=$2
  local unit=$3
  local state

  state=$(systemctl_user "${systemctl_cmd}" "${action}" "${unit}" 2>/dev/null || :)
  printf '%s\n' "${state:-unknown}"
}

command_list() {
  local udevadm_cmd

  udevadm_cmd=$(find_command udevadm)
  discover_devices "${udevadm_cmd}"
  print_devices
}

command_status() {
  local systemctl_cmd

  systemctl_cmd=$(find_command systemctl)
  if [[ -e ${rule_path} ]]; then
    printf 'Udev rule:       installed (%s)\n' "${rule_path}"
  else
    printf 'Udev rule:       not installed\n'
  fi
  if [[ -e ${marker_path} ]]; then
    printf 'Selected key:    present (%s)\n' "${marker_path}"
  else
    printf 'Selected key:    absent\n'
  fi
  printf 'Default service: %s, %s\n' \
    "$(unit_state "${systemctl_cmd}" is-enabled "${default_service}")" \
    "$(unit_state "${systemctl_cmd}" is-active "${default_service}")"
  printf 'Device path:     %s, %s\n' \
    "$(unit_state "${systemctl_cmd}" is-enabled "${device_path_unit}")" \
    "$(unit_state "${systemctl_cmd}" is-active "${device_path_unit}")"
  printf 'Device service:  %s, %s\n' \
    "$(unit_state "${systemctl_cmd}" is-enabled "${device_service}")" \
    "$(unit_state "${systemctl_cmd}" is-active "${device_service}")"
}

command_enable() {
  local assume_yes=false
  local requested_id=
  local arg systemctl_cmd udevadm_cmd sudo_cmd
  local restart_device_service=false

  selected_device_id=

  for arg in "$@"; do
    case ${arg} in
      --yes) assume_yes=true ;;
      -*) die "unknown enable option: ${arg}" ;;
      *)
        [[ -z ${requested_id} ]] || die 'enable accepts at most one device ID'
        requested_id=${arg}
        ;;
    esac
  done

  systemctl_cmd=$(find_command systemctl)
  udevadm_cmd=$(find_command udevadm)
  sudo_cmd=$(find_command sudo)
  systemctl_user "${systemctl_cmd}" daemon-reload
  systemctl_user "${systemctl_cmd}" cat "${device_path_unit}" >/dev/null 2>&1 || \
    die "${device_path_unit} is not installed"
  systemctl_user "${systemctl_cmd}" cat "${device_service}" >/dev/null 2>&1 || \
    die "${device_service} is not installed"
  if systemctl_user "${systemctl_cmd}" is-active --quiet "${device_service}"; then
    restart_device_service=true
  fi

  if [[ -n ${requested_id} ]]; then
    selected_device_id=$(normalize_device_id "${requested_id}")
  else
    choose_device "${udevadm_cmd}"
    selected_device_id=${selected_device_id:-${device_ids[0]}}
  fi

  if [[ -e ${rule_path} ]] && ! rule_is_related; then
    die "${rule_path} exists but is not a ${program} device-gate rule"
  fi
  confirm_or_exit "${assume_yes}" \
    "Enable the popup for every FIDO authenticator matching ${selected_device_id}?"

  privileged_setup "${sudo_cmd}" enable "${selected_device_id}"

  if ! systemctl_user "${systemctl_cmd}" disable --now "${default_service}"; then
    die "the udev rule remains installed, but ${default_service} could not be disabled"
  fi
  if ! systemctl_user "${systemctl_cmd}" enable --now "${device_path_unit}"; then
    warn "enabling ${device_path_unit} failed; restoring ${default_service}"
    systemctl_user "${systemctl_cmd}" enable --now "${default_service}" || \
      warn "automatic rollback also failed; inspect the user units with systemctl --user status"
    die "the udev rule remains installed at ${rule_path}"
  fi
  if [[ ${restart_device_service} == true ]] && \
    ! systemctl_user "${systemctl_cmd}" try-restart "${device_service}"; then
    die "device gating is enabled, but ${device_service} could not be restarted"
  fi

  printf 'Device gating enabled for %s.\n' "${selected_device_id}"
  command_status
}

command_disable() {
  local assume_yes=false
  local arg systemctl_cmd sudo_cmd

  for arg in "$@"; do
    case ${arg} in
      --yes) assume_yes=true ;;
      *) die "unknown disable option: ${arg}" ;;
    esac
  done

  if [[ -e ${rule_path} ]] && ! rule_is_related; then
    die "${rule_path} exists but is not a ${program} device-gate rule"
  fi
  confirm_or_exit "${assume_yes}" \
    'Disable device gating and restore the always-running popup service?'

  systemctl_cmd=$(find_command systemctl)
  systemctl_user "${systemctl_cmd}" daemon-reload
  systemctl_user "${systemctl_cmd}" disable --now "${device_path_unit}"
  if ! systemctl_user "${systemctl_cmd}" enable --now "${default_service}"; then
    warn "restoring ${default_service} failed; re-enabling ${device_path_unit}"
    systemctl_user "${systemctl_cmd}" enable --now "${device_path_unit}" || true
    die 'device gating was left enabled'
  fi

  if [[ -e ${rule_path} ]]; then
    sudo_cmd=$(find_command sudo)
    privileged_setup "${sudo_cmd}" disable
  fi

  printf '%s\n' 'Device gating disabled; the default popup service is enabled.'
  command_status
}

main() {
  local command=${1:-}

  case ${command} in
    -h|--help|help)
      usage
      return
      ;;
  esac

  if (( EUID == 0 )); then
    die 'run this command as the desktop user, not with sudo'
  fi
  [[ -n ${command} ]] || {
    usage >&2
    exit 2
  }
  shift

  case ${command} in
    list)
      (( $# == 0 )) || die 'list does not accept arguments'
      command_list
      ;;
    enable) command_enable "$@" ;;
    status)
      (( $# == 0 )) || die 'status does not accept arguments'
      command_status
      ;;
    disable) command_disable "$@" ;;
    *)
      usage >&2
      die "unknown command: ${command}"
      ;;
  esac
}

main "$@"
